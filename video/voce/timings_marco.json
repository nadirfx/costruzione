  {
   "i": 3,
   "text": "Anzi.",
   "start": 3.964,
   "end": 4.388
  },
  {
   "i": 4,
   "text": "Lo pagavo 1.400 euro al mese, per 20 video.",
   "start": 4.69,
   "end": 7.574
  },
  {
   "i": 5,
   "text": "Il problema?",
   "start": 7.85,
   "end": 8.454
