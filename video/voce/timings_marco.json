 "phrases": [
  {
   "i": 0,
   "text": "Ho licenziato il mio video editor.",
   "start": 0.05,
   "end": 1.76
  },
  {
   "i": 1,
   "text": "E no,",
   "start": 2.2,
   "end": 2.56
  },
  {
   "i": 2,
   "text": "non era scarso.",
