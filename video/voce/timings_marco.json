   "text": "Adesso i video li faccio io, con Claude.",
   "start": 17.264,
   "end": 19.061
  },
  {
   "i": 11,
   "text": "Scrivo l'idea,",
   "start": 19.287,
   "end": 20.021
  },
  {
   "i": 12,
   "text": "e lui mi fa script, animazioni e suoni.",
   "start": 20.111,
   "end": 22.197
  },
  {
   "i": 13,
   "text": "Voglio cambiare qualcosa?",
   "start": 22.571,
   "end": 23.722
  },
  {
   "i": 14,
   "text": "Lo cambio subito.",
   "start": 23.958,
   "end": 24.789
  },
  {
